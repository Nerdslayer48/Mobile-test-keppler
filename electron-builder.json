{
  "appId": "com.keppler.desktop",
  "productName": "Keppler",
  "directories": { "output": "release", "app": "build/desktop-app" },
  "files": ["dist/**/*", "electron/**/*", "package.json"],
  "asar": true,
  "electronDist": "node_modules/electron/dist",
  "win": {
    "icon": "build/icon.ico",
    "target": ["nsis", "portable"]
  },
  "nsis": {
    "artifactName": "Keppler-Setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "Keppler.${ext}"
  }
}
