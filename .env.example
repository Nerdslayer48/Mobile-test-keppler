# Server only. Never use a VITE_ prefix for the database connection string.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
# Direct connection for migrations (neon deploy supplies both URLs).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-DIRECT-NEON-HOST/DBNAME?sslmode=require
# Generate once with npm run api:init; keep the real value private and stable.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,null
# Public URL only. Set to a deployed HTTPS API URL when distributing the desktop app.
VITE_API_URL=https://br-winter-surf-b5db498m-kepplerapi.compute.c-7.us-east-2.aws.neon.tech/api
