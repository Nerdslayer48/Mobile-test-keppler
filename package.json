{
  "name": "keppler",
  "description": "Keppler desktop workspace",
  "private": true,
  "version": "1.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:electron": "node scripts/electron-dev.mjs",
    "start": "npm run build && node scripts/electron-start.mjs",
    "dist:win": "npm run icon:build && npm run build && node scripts/prepare-desktop.mjs && electron-builder --win --x64 --publish never",
    "pack:win": "npm run icon:build && npm run build && node scripts/prepare-desktop.mjs && electron-builder --win --x64 --dir --publish never",
    "icon:build": "node scripts/build-icon.mjs",
    "test:electron": "node --import tsx scripts/smoke-online-electron.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "db:check": "tsx server/check.ts",
    "api:start": "tsx server/start.ts",
    "api:dev": "tsx watch server/start.ts",
    "api:init": "tsx server/init-secrets.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "tsx server/schema.test.ts",
    "test:api": "tsx server/api.test.ts",
    "test:neon": "tsx server/api.test.ts --live",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:invoice": "node --import tsx scripts/invoice.test.ts",
    "test:startup": "node scripts/smoke-startup-electron.mjs",
    "test:moodboard": "node scripts/smoke-moodboard-electron.mjs",
    "test:function": "tsx server/api.test.ts --fetch"
  },
  "dependencies": {
    "@fontsource/inder": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neon/functions": "^0.11.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fetch-to-node": "^2.1.0",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "png-to-ico": "^3.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
